// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  JOB_SEEKER
  EMPLOYER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  firstName     String?
  lastName      String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  role        Role?
  companyName String?

  profile               Profile?
  companyProfile        CompanyProfile?
  accounts              Account[]
  sessions              Session[]
  jobs                  Job[]           @relation("postedJobs")
  applications          Application[]
  interviewsAsEmployer  Interview[]     @relation("employerInterviews")
  interviewsAsJobSeeker Interview[]     @relation("jobSeekerInterviews")
  savedJobs             SavedJob[]
  notifications         Notification[]
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  headline       String?
  location       String?
  phone          String?
  summary        String?  @db.Text
  skills         String[] @default([])
  cvUrl          String?
  bannerUrl      String?
  recruiterNotes String?  @db.Text
  matchScore     Int?     @default(90)

  experiences WorkExperience[]
  educations  Education[]
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompanyProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  overview        String?  @db.Text
  history         String?  @db.Text
  targetCustomers String?  @db.Text
  mission         String?  @db.Text
  industry        String?
  website         String?
  headquarters    String?
  companySize     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkExperience {
  id          String  @id @default(cuid())
  profileId   String
  title       String
  company     String
  location    String?
  startDate   String
  endDate     String?
  description String? @db.Text

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Education {
  id           String  @id @default(cuid())
  profileId    String
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    String
  endDate      String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum JobStatus {
  ACTIVE
  DRAFT
  CLOSED
}

model Job {
  id              String    @id @default(cuid())
  title           String
  company         String
  location        String
  type            String
  category        String
  locationType    String    @default("onsite")
  description     String    @db.Text
  companyOverview String?   @db.Text
  salary          String
  requirements    String[]  @default([])
  benefits        String[]  @default([])
  visibility      String    @default("PUBLIC")
  status          JobStatus @default(ACTIVE)
  expirationDate  DateTime?
  isExpired       Boolean   @default(false)

  postedAt   DateTime   @default(now())
  postedBy   User       @relation("postedJobs", fields: [postedById], references: [id])
  postedById String
  savedBy    SavedJob[]

  applications Application[]
  createdAt    DateTime      @default(now())
}

model SavedJob {
  id      String   @id @default(cuid())
  userId  String
  jobId   String
  savedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Application {
  id        String     @id @default(cuid())
  jobId     String
  userId    String
  status    String     @default("PENDING")
  appliedAt DateTime   @default(now())
  interview Interview?

  user User @relation(fields: [userId], references: [id])
  job  Job  @relation(fields: [jobId], references: [id])

  @@unique([jobId, userId])
}

enum InterviewMode {
  ONSITE
  ONLINE
}

enum InterviewStatus {
  PENDING_JOBSEEKER
  PENDING_EMPLOYER
  ACCEPTED
  REJECTED
}

enum InterviewProposedBy {
  EMPLOYER
  JOBSEEKER
}

model Interview {
  id            String              @id @default(cuid())
  applicationId String              @unique
  employerId    String
  jobSeekerId   String
  proposedAt    DateTime
  mode          InterviewMode
  details       String              @db.Text
  status        InterviewStatus     @default(PENDING_JOBSEEKER)
  proposedBy    InterviewProposedBy @default(EMPLOYER)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  employer    User        @relation("employerInterviews", fields: [employerId], references: [id], onDelete: Cascade)
  jobSeeker   User        @relation("jobSeekerInterviews", fields: [jobSeekerId], references: [id], onDelete: Cascade)

  @@index([employerId, status])
  @@index([jobSeekerId, status])
}

enum NotificationType {
  NEW_JOB_MATCH
  PROFILE_VIEW
  NEW_APPLICANT
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  INTERVIEW_PROPOSED
  INTERVIEW_UPDATED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}
